# Copy to .env and fill in your own values. .env stays on your PC (git-ignored).
# Every value can also be set as an environment variable of the same name.

# PLEX_DATA=E:\PlexData\Plex Media Server
# PLEX_SQLITE=C:\Program Files\Plex\Plex Media Server\Plex SQLite.exe
# PLEX_URL=http://127.0.0.1:32400

# NAS name -> IP address (Plex paths like \diskstation\... are compared in IP form)
NAS_HOSTS=diskstation=192.168.1.10;syno2=192.168.1.11
# Fallback when a drive letter is not connected: drive=share, separated by ;
DRIVE_SHARES=U:=\\192.168.1.10\Share1;V:=\\192.168.1.11\Share2

# DeepSeek (optional, AI helpers): the key itself, or a file with the key on line 1
# DEEPSEEK_API_KEY=
# DEEPSEEK_KEY_FILE=C:\keys\deepseek.txt
